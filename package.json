{
	"name": "islamic-trust-gen",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"test": "vitest run",
		"build": "vitest run && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "npx @better-auth/cli generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/postcss": "^4.2.1",
		"@types/node": "^22",
		"autoprefixer": "^10.4.24",
		"better-auth": "^1.4.18",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"postcss": "^8.5.6",
		"svelte": "^5.51.0",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.0.2",
		"@tailwindcss/vite": "^4.2.1",
		"@types/video.js": "^7.3.58",
		"@uploadthing/svelte": "^7.3.3",
		"angular-expressions": "^1.5.1",
		"docxtemplater": "^3.68.6",
		"pizzip": "^3.2.0",
		"resend": "^6.9.2",
		"stripe": "^22.0.0",
		"uploadthing": "^7.7.4",
		"video.js": "^8.23.7"
	}
}
