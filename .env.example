# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://user:password@host:port/db-name"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# https://dashboard.stripe.com/webhooks (or `stripe listen` in dev)
STRIPE_WEBHOOK_SECRET=""

CALENDLY_API_TOKEN=""
CALENDLY_WEBHOOK_SIGNING_KEY=""
CALENDLY_EVENT_TYPE_URI=""

# Resend (email)
# https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender address in Resend
FROM_EMAIL="noreply@muslimlegacyplanning.com"
# Firm inbox – used as reply-to on marketing emails
REPLY_TO_EMAIL="info@mcdanielestateplanning.com"

# Vercel Cron secret – set to a long random string; passed as Authorization: Bearer header
CRON_SECRET=""

